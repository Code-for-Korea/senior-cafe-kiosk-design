#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

remote="${GITHUB_PAGES_REMOTE:-origin}"
branch="${GITHUB_PAGES_BRANCH:-gh-pages}"
base_path="${GITHUB_PAGES_BASE_PATH:-/senior-cafe-kiosk-design/}"
allow_dirty=false

usage() {
  cat <<'EOF'
Usage: bin/deploy [--allow-dirty]

Builds the Vite app and publishes dist/ as a single orphan commit to the
GitHub Pages branch with a force-push. The Pages branch is generated and
overwritten on every deploy, so do not edit it by hand.

Environment variables:
  GITHUB_PAGES_REMOTE      Git remote to push (default: origin)
  GITHUB_PAGES_BRANCH      Pages branch (default: gh-pages)
  GITHUB_PAGES_BASE_PATH   Vite base path (default: /senior-cafe-kiosk-design/)

The default mode refuses to deploy when the working tree has uncommitted changes.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --allow-dirty) allow_dirty=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

command -v git >/dev/null || { echo "git is required" >&2; exit 1; }
command -v pnpm >/dev/null || { echo "pnpm is required" >&2; exit 1; }
git remote get-url "$remote" >/dev/null || { echo "Git remote not found: $remote" >&2; exit 1; }

if [[ "$allow_dirty" != true ]] && [[ -n "$(git status --porcelain)" ]]; then
  echo "Working tree is not clean. Commit or stash changes, or use --allow-dirty." >&2
  git status --short >&2
  exit 1
fi

case "$base_path" in
  /*/) ;;
  *) echo "GITHUB_PAGES_BASE_PATH must start and end with '/': $base_path" >&2; exit 2 ;;
esac

remote_url="$(git remote get-url "$remote")"
short_sha="$(git rev-parse --short HEAD)"

echo "Building GitHub Pages site with base path: $base_path"
VITE_BASE_PATH="$base_path" pnpm run build:preview
test -f dist/index.html || { echo "Build output not found: dist/index.html" >&2; exit 1; }

# dist/ is gitignored, so publish a copy of it from a temporary orphan repository.
stage="$(mktemp -d "${TMPDIR:-/tmp}/github-pages.XXXXXX")"
trap 'rm -rf -- "$stage"' EXIT

cp -a dist/. "$stage/"
# Prevent GitHub Pages/Jekyll from ignoring files whose names begin with '_'.
touch "$stage/.nojekyll"

git -C "$stage" init -q -b "$branch"
git -C "$stage" add --all
git -C "$stage" \
  -c user.name="GitHub Pages deploy" \
  -c user.email="github-pages-deploy@users.noreply.github.com" \
  commit -qm "Deploy GitHub Pages site from $short_sha"

echo "Publishing dist/ to: remote=$remote_url branch=$branch base path=$base_path"
git -C "$stage" push --force "$remote_url" "HEAD:$branch"

echo "Published dist/ as a single orphan commit to '$branch' (force-push). Enable GitHub Pages with source '$branch' in repository settings. The branch is generated; do not edit it by hand."
